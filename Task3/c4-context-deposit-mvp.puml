@startuml c4-context-deposit-mvp
!include <C4/C4_Context>

title Банк «Стандарт». Открытие депозитов онлайн (MVP)\nДиаграмма контекста (C4, уровень 1)

LAYOUT_TOP_DOWN()

Person(prospect, "Потенциальный клиент", "Ещё не клиент банка. Смотрит ставки и оставляет заявку на сайте")
Person(client, "Клиент банка", "Пользователь интернет-банка")
Person(cc_operator, "Оператор кол-центра", "Звонит по заявкам с сайта, предлагает особые условия")
Person(front, "Сотрудник отделения", "Фронт-офис: идентифицирует клиента, открывает депозит")
Person(back_dep, "Менеджер бэк-офиса депозитов", "Ведёт ставки, обрабатывает заявки")
Person(back_cred, "Сотрудник бэк-офиса кредитов", "Вносит оценку кредитного риска")

System(site, "Сайт", "PHP + React.js. Каталог депозитов со ставками, форма заявки")
System(ib, "Интернет-банк", "Монолит ASP.NET MVC 4.5 + MS SQL (платформа подрядчика) и новые сервисы депозитов на .NET 8")
System(kafka, "Интеграционная шина", "Apache Kafka. Асинхронный обмен ставками, заявками и статусами")
System(abs, "АБС", "Delphi + Oracle (PL/SQL). Справочник и согласование ставок, обработка заявок, открытие депозитов")
System(cc, "Система кол-центра", "Платформа подрядчика: React, Java Spring Boot, PostgreSQL. Модуль заявок на депозит")
System_Ext(sms_gw, "СМС-шлюз", "Шлюз телеком-оператора")
System_Ext(telecom, "Телеком-оператор", "Доставка СМС")

Rel(prospect, site, "UC2, UC3: смотрит ставки, подаёт заявку", "HTTPS")
Rel(client, ib, "UC6, UC7, UC9: ставки, заявка, статус", "HTTPS")
Rel(site, ib, "Получает ставки, передаёт заявку", "HTTPS/REST")
Rel(ib, kafka, "Публикует заявки; получает ставки и статусы", "Kafka, TLS")
Rel(abs, kafka, "Публикует ставки и статусы; получает заявки", "Kafka, TLS")
Rel(kafka, cc, "Заявки с сайта, ставки", "Kafka, TLS")
Rel(cc_operator, cc, "UC4: работает с заявками")
Rel(cc, abs, "UC4: обращение на особые условия (существующая интеграция)")
Rel(back_cred, abs, "UC1: оценка риска", "Delphi-клиент")
Rel(back_dep, abs, "UC1, UC4, UC8: ставки, заявки", "Delphi-клиент")
Rel(front, abs, "UC5: открытие депозита", "Delphi-клиент")
Rel(ib, sms_gw, "UC7, UC9: СМС-код и уведомления", "HTTPS")
Rel(abs, sms_gw, "UC4: СМС по обращению из КЦ")
Rel(sms_gw, telecom, "Отправка СМС")

SHOW_LEGEND()
@enduml
