<mxfile host="app.diagrams.net"><diagram id="integration" name="Интеграция As-Is"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="1418" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Схема интеграции приложений банка «Стандарт» (As-Is)&lt;/b&gt; — процесс открытия депозита" style="text;html=1;fontSize=22;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1500" height="40" as="geometry"/></mxCell><mxCell id="client" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;в основном старшего возраста&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#08427b;strokeColor=#073b6f;fontColor=#ffffff;fontSize=14;arcSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="170" height="70" as="geometry"/></mxCell><mxCell id="site" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;PHP + React.js&lt;br&gt;только маркетинговая информация&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="220" height="80" as="geometry"/></mxCell><mxCell id="ib" value="&lt;b&gt;Интернет-банк&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;ASP.NET MVC 4.5, платформа подрядчика&lt;br&gt;платежи, текущие счета&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1168bd;strokeColor=#0b4884;fontColor=#ffffff;fontSize=14;" vertex="1" parent="1"><mxGeometry x="300" y="220" width="220" height="80" as="geometry"/></mxCell><mxCell id="ibdb" value="БД ИБ&lt;br&gt;&lt;font style='font-size:11px'&gt;MS SQL&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#438dd5;strokeColor=#3c7fc0;fontColor=#ffffff;fontSize=13;" vertex="1" parent="1"><mxGeometry x=