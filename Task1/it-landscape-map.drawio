<mxfile host="app.diagrams.net"><diagram name="IT-ландшафт As-Is" id="landscape"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="Карта текущего IT-ландшафта банка «Стандарт» (As-Is)" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1420" height="40" as="geometry"/></mxCell><mxCell id="c3" value="Подразделение \ Бизнес-возможность" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1f5bd1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="280" height="100" as="geometry"/></mxCell><mxCell id="c4" value="Продажи и маркетинг" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1f5bd1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="60" width="570" height="40" as="geometry"/></mxCell><mxCell id="c5" value="Поддержка операционных процессов" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#1f5bd1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="60" width="570" height="40" as="geometry"/></mxCell><mxCell id="c6" value="Продажи в сети отделений" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c7" value="Продажи через кол-центр" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="490" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c8" value="Digital-оповещения клиентов" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="680" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c9" value="Обслуживание депозитных процессов" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c10" value="Обслуживание кредитных процессов" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1060" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c11" value="Управление договорами" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="100" width="190" height="60" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Управление обслуживанием в сети отделений&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;фронт-офис, 50 отделений, 500 чел.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="160" width="280" height="90" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;АБС + почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ставку запрашивают письмом у бэк-офиса&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="300" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c14" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="490" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c15" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="680" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;АБС + почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;создание депозита в АБС после согласования ставки&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;АБС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;выдача документов, загрузка подписанных документов&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="160" width="190" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Управление IT&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ИБ: 10 + 10 подрядчик; АБС: 20 чел.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="250" width="280" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;разработка и сопровождение&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="300" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;Интеграция Система КЦ → АБС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;СМС-шлюз, Сайт, Интернет-банк&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;поддержка шлюза совместно с телеком-оператором&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;АБС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="870" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;АБС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;АБС&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1250" y="250" width="190" height="90" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Управление обслуживанием депозитных продуктов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;бэк-офис, 50 чел.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="280" height="90" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ответ фронт-офису со ставкой&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="300" y="340" width="190" height="90" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ручная обработка обращений из КЦ, указание ставки&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="490" y="340" width="190" height="90" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;АБС → СМС-шлюз&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;СМС клиенту о ставке&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="680" y="340" width="190" height="90" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;Excel + почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;расчёт ставки, в т.ч. специальной&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="870" y="340" width="190" height="90" as="geometry"/></mxCell><mxCell id="c31" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1060" y="340" width="190" height="90" as="geometry"/></mxCell><mxCell id="c32" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1250" y="340" width="190" height="90" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Управление обслуживанием кредитных продуктов&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;бэк-офис, 50 чел.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="430" width="280" height="90" as="geometry"/></mxCell><mxCell id="c34" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="c35" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="490" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="c36" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="680" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="c37" value="&lt;b&gt;Excel + почта&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;ежедневный расчёт ставок, данные о кредитном риске клиента&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="870" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;АБС&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;кредитный раздел, анализ кредитного риска&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1060" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="c39" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1250" y="430" width="190" height="90" as="geometry"/></mxCell><mxCell id="c40" value="&lt;b&gt;Кол-центр банка&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;200 операторов; поддержка подрядчика 5 чел.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="280" height="90" as="geometry"/></mxCell><mxCell id="c41" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="520" width="190" height="90" as="geometry"/></mxCell><mxCell id="c42" value="&lt;b&gt;Система КЦ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;обращение передаётся в АБС&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="490" y="520" width="190" height="90" as="geometry"/></mxCell><mxCell id="c43" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="680" y="520" width="190" height="90" as="geometry"/></mxCell><mxCell id="c44" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="870" y="520" width="190" height="90" as="geometry"/></mxCell><mxCell id="c45" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1060" y="520" width="190" height="90" as="geometry"/></mxCell><mxCell id="c46" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1250" y="520" width="190" height="90" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;Партнёрский кол-центр&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;100 чел., внешняя компания&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="610" width="280" height="90" as="geometry"/></mxCell><mxCell id="c48" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="c49" value="&lt;b&gt;Система партнёрского КЦ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;работа по скриптам, переданным бизнесом&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="490" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="c50" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="680" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="c51" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="870" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="c52" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1060" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="c53" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1250" y="610" width="190" height="90" as="geometry"/></mxCell><mxCell id="c54" value="&lt;b&gt;Команда цифровой трансформации розничного бизнеса&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;10 чел.&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="20" y="700" width="280" height="90" as="geometry"/></mxCell><mxCell id="c55" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="c56" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="490" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="c57" value="&lt;b&gt;Сайт&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;только маркетинговая информация&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="680" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="c58" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="870" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="c59" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1060" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="c60" value="—" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="1250" y="700" width="190" height="90" as="geometry"/></mxCell><mxCell id="c61" value="&lt;b&gt;Легенда&lt;/b&gt;" style="text;html=1;align=left;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="820" width="200" height="24" as="geometry"/></mxCell><mxCell id="c62" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="20" y="848" width="40" height="24" as="geometry"/></mxCell><mxCell id="c63" value="Возможность поддержана IT-системой" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="848" width="400" height="24" as="geometry"/></mxCell><mxCell id="c64" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="20" y="878" width="40" height="24" as="geometry"/></mxCell><mxCell id="c65" value="Система + ручные операции / ограниченная поддержка" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="878" width="400" height="24" as="geometry"/></mxCell><mxCell id="c66" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="20" y="908" width="40" height="24" as="geometry"/></mxCell><mxCell id="c67" value="Нет поддержки IT-системой: Excel, электронная почта" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="908" width="400" height="24" as="geometry"/></mxCell><mxCell id="c68" value="" style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#cccccc;fontColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="938" width="40" height="24" as="geometry"/></mxCell><mxCell id="c69" value="Подразделение не участвует" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="938" width="400" height="24" as="geometry"/></mxCell><mxCell id="c70" value="&lt;b&gt;Выводы: что мешает сделать депозит цифровым продуктом&lt;/b&gt;&lt;br&gt;1. Ставки по депозитам не ведутся ни в одной системе — только Excel-файлы, ежедневно рассылаемые по почте.&lt;br&gt;2. Согласование ставки (особенно специальной) идёт перепиской фронт-офис ↔ бэк-офис депозитов ↔ кредиты: по требованиям безопасности подразделения не видят данных друг друга.&lt;br&gt;3. Интернет-банк и сайт не участвуют в продажах и обслуживании депозитов: в BCM нет онлайн-канала продаж.&lt;br&gt;4. Обращения из кол-центра обрабатываются в АБС вручную; партнёрский КЦ не интегрирован и работает по скриптам." style="rounded=0;whiteSpace=wrap;html=1;fontSize=12;align=left;verticalAlign=top;spacing=8;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="500" y="818" width="940" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
